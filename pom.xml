<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.spawnplugin</groupId>
    <artifactId>RandomSpawn</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>RandomSpawn</name>
    <description>Teleports players to a random location from a predefined list on join, on respawn, and via /spawn.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Paper 26.2 requires a Java 25 toolchain. -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
            Provided by the server at runtime - do not shade/bundle this.
            Pinned to the exact build that this project was verified to compile
            against. To pick up a newer build, browse
            https://repo.papermc.io/#browse/browse:maven-public:io%2Fpapermc%2Fpaper%2Fpaper-api
            and swap the version below.
        -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.112-stable</version>
            <scope>provided</scope>
        </dependency>

        <!--
            bStats metrics. This IS bundled into the jar (compile scope) and
            relocated by the shade plugin below, per bStats' own instructions,
            so it doesn't clash with other plugins that also bundle bStats.
        -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.1.0</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <!-- Enable filtering so plugin.yml's ${project.version} is substituted. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <!--
                Shades (bundles) bStats into the output jar and relocates its
                package so it doesn't collide with other plugins' copies of
                bStats. This replaces plain maven-jar-plugin as the packaging
                step, since a plain jar wouldn't include bStats' classes.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <!--
                    The Shade Plugin bundles an old ASM that can't read Java 25
                    class files ("Unsupported class file major version 69").
                    Overriding ASM here fixes it - see
                    https://github.com/apache/maven-shade-plugin/issues/791
                -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.9.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.9.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <!-- Keep this in sync with the package below. -->
                                    <shadedPattern>com.example.spawnplugin.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
